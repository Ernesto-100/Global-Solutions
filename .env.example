# ─── DATABASE ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://truebooks:truebooks@localhost:5432/truebooks
REDIS_URL=redis://localhost:6379

# ─── AUTH ───────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=your-secret-here-change-in-production
NEXTAUTH_URL=http://localhost:3001

# ─── AI / ANTHROPIC ─────────────────────────────────────────────────────────────
